@using JuanIgnacio.Portfolio.Web.Models

<header class="site-header">
    <a class="brand" href="#top" aria-label="Juan Ignacio">
        <span class="brand-mark">JI</span>
        <span>Juan Ignacio</span>
    </a>

    <nav class="main-nav" aria-label="Primary navigation">
        <a href="#about">@Content.Nav.About</a>
        <a href="#goal">@Content.Nav.Goal</a>
        <a href="#interests">@Content.Nav.Interests</a>
        <a href="#projects">@Content.Nav.Projects</a>
        <a href="#experience">@Content.Nav.Experience</a>
        <a href="#skills">@Content.Nav.Skills</a>
        <a href="#cv">@Content.Nav.Cv</a>
        <a href="#contact">@Content.Nav.Contact</a>
    </nav>

    <div class="language-switcher" aria-label="Language selector">
        @foreach (var language in Languages)
        {
            <button type="button"
                    class="@GetLanguageButtonClass(language.Code)"
                    aria-pressed="@(language.Code == CurrentLanguage)"
                    title="@language.NativeLabel"
                    @onclick="() => OnLanguageChanged.InvokeAsync(language.Code)">
                @language.Label
            </button>
        }
    </div>
</header>

@code {
    [Parameter, EditorRequired] public PortfolioContent Content { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<LanguageOption> Languages { get; set; } = [];
    [Parameter, EditorRequired] public string CurrentLanguage { get; set; } = "es";
    [Parameter, EditorRequired] public EventCallback<string> OnLanguageChanged { get; set; }

    private string GetLanguageButtonClass(string languageCode)
    {
        return languageCode == CurrentLanguage ? "active" : string.Empty;
    }
}
