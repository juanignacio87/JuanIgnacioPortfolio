@using JuanIgnacio.Portfolio.Web.Models
<section id="contact" class="contact-band content-section" aria-labelledby="contact-title">
    <div class="section-shell contact-layout">
        <div>
            <p class="section-kicker">05 / @Content.Visual.ContactKicker</p>
            <h2 id="contact-title">@Content.ContactTitle</h2>
            <p class="lead-text">@Content.Contact.Intro</p>
            <div class="availability">
                <span class="availability-dot" aria-hidden="true"></span>
                <span>@Content.AvailableFor.Title</span>
            </div>
            <TechBadges Technologies="Content.AvailableFor.Items" />
        </div>
        <div class="contact-directory">
            <ProfessionalLink Label="@Content.Contact.EmailLabel" Detail="@SiteOptions.Email" Url="@EmailUrl" />
            <ProfessionalLink Label="@Content.Contact.LinkedInLabel" Url="@SiteOptions.LinkedInUrl" />
            <ProfessionalLink Label="@Content.Contact.GitHubLabel" Url="@SiteOptions.GitHubUrl" />
            <div id="cv" class="contact-cv">
                <CvLink Content="Content" SiteOptions="SiteOptions" />
            </div>
        </div>
    </div>
</section>
@code {
    [Parameter, EditorRequired] public PortfolioContent Content { get; set; } = default!;
    [Parameter, EditorRequired] public SiteOptions SiteOptions { get; set; } = default!;
    private string EmailUrl => string.IsNullOrWhiteSpace(SiteOptions.Email) ? "" : $"mailto:{SiteOptions.Email}";
}
