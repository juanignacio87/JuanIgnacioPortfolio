@using JuanIgnacio.Portfolio.Web.Models

<section id="projects" class="content-section projects-band">
    <div class="section-shell">
        <div class="section-heading">
            <p class="section-kicker">04</p>
            <h2>@Content.ProjectsTitle</h2>
            <p>@Content.ProjectsIntro</p>
        </div>

        <div class="project-grid">
            @foreach (var project in Content.Projects)
            {
                <article class="project-card">
                    <div class="project-media">
                        @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                        {
                            <img src="@project.ImageUrl" alt="@project.ImageAlt" loading="lazy" />
                        }
                        else
                        {
                            <div class="project-media-placeholder" role="img" aria-label="@Content.ProjectLabels.ImagePlaceholder">
                                <span class="placeholder-icon" aria-hidden="true">@GetProjectInitials(project.Title)</span>
                                <strong>@Content.ProjectLabels.ImagePlaceholder</strong>
                            </div>
                        }
                    </div>

                    <div class="project-card-body">
                        <div class="project-card-header">
                            <h3>@project.Title</h3>
                            <span>@Content.ProjectLabels.Status: @project.Status</span>
                        </div>
                        <p>@project.Description</p>
                        <dl class="project-details">
                            <div>
                                <dt>@Content.ProjectLabels.Problem</dt>
                                <dd>@project.Problem</dd>
                            </div>
                            <div>
                                <dt>@Content.ProjectLabels.Role</dt>
                                <dd>@project.Role</dd>
                            </div>
                            <div>
                                <dt>@Content.ProjectLabels.NextStep</dt>
                                <dd>@project.NextStep</dd>
                            </div>
                        </dl>
                    </div>

                    <div class="project-card-footer">
                        <p class="tech-label">@Content.ProjectLabels.Technologies</p>
                        <div class="tech-list">
                            @foreach (var technology in project.Technologies)
                            {
                                <span>@technology</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(project.ProjectUrl) || !string.IsNullOrWhiteSpace(project.RepositoryUrl))
                        {
                            <div class="project-actions">
                                @if (!string.IsNullOrWhiteSpace(project.ProjectUrl))
                                {
                                    <a class="button primary" href="@project.ProjectUrl" target="_blank" rel="noreferrer">@Content.ProjectLabels.ViewProject</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.RepositoryUrl))
                                {
                                    <a class="button ghost" href="@project.RepositoryUrl" target="_blank" rel="noreferrer">@Content.ProjectLabels.ViewRepository</a>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public PortfolioContent Content { get; set; } = default!;

    private static string GetProjectInitials(string title)
    {
        var words = title.Split(new[] { ' ', '/', '-' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])));
    }
}
