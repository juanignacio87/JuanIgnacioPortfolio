@using JuanIgnacio.Portfolio.Web.Models
<section id="projects" class="projects-band content-section" aria-labelledby="projects-title">
<div class="section-shell">
    <div class="section-heading"><p class="section-kicker">02 / @Content.Nav.Projects</p><h2 id="projects-title">@Content.ProjectsTitle</h2><p>@Content.ProjectsIntro</p></div>
    @{ var featured = Content.Projects[0]; }
    <article class="featured-project">
        <div class="featured-summary"><p class="section-kicker">@Content.Visual.FeaturedLabel</p><div class="featured-name"><h3>CattleCat<span>.</span></h3><span class="status functional">@featured.Status</span></div><p class="featured-intro">@Content.Featured.Intro</p><p>@featured.Description</p><TechBadges Technologies="featured.Technologies" /><dl class="featured-role"><dt>@Content.ProjectLabels.Role</dt><dd>@featured.Role</dd></dl><a class="button primary" href="@featured.RepositoryUrl" target="_blank" rel="noopener noreferrer">@Content.ProjectLabels.ViewRepository <Icon Name="arrow-up-right" /></a></div>
        <div class="featured-features"><ul>@foreach(var feature in Content.Featured.Features){<li><Icon Name="check" /><span>@feature</span></li>}</ul><div class="next-step"><span>@Content.ProjectLabels.NextStep</span><p>@featured.NextStep</p></div></div>
        <div class="project-gallery"><h4>@Content.Featured.GalleryTitle</h4>
            @if (SiteOptions.CattleCatScreenshots.Any(s => !string.IsNullOrWhiteSpace(s.Url)))
            {
                <div class="gallery-grid">@foreach (var shot in SiteOptions.CattleCatScreenshots.Where(s => !string.IsNullOrWhiteSpace(s.Url))){<a href="@shot.Url" target="_blank" rel="noopener noreferrer"><img src="@shot.Url" alt="@shot.GetAlt(Content.LanguageCode)" loading="lazy" /><span>@shot.GetAlt(Content.LanguageCode) <Icon Name="arrow-up-right" /></span></a>}</div>
            }
            else
            {<div class="gallery-pending"><Icon Name="image" /><p>@Content.Visual.GalleryPending</p></div>}
        </div>
    </article>
    <h3 class="other-title">@Content.Visual.OtherProjects</h3>
    <div class="project-grid">
        @foreach (var project in Content.Projects.Skip(1))
        {
            <ProjectCard Project="project" Labels="Content.ProjectLabels" Index="@(Content.Projects.ToList().IndexOf(project))" />
        }
    </div>
</div>
</section>
@code {
    [Parameter, EditorRequired] public PortfolioContent Content { get; set; } = default!;
    [Parameter, EditorRequired] public SiteOptions SiteOptions { get; set; } = default!;
}
