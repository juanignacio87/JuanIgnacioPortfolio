@using JuanIgnacio.Portfolio.Web.Models

<section id="top" class="hero section-shell">
    <div class="hero-content">
        <p class="eyebrow">@Content.Hero.Eyebrow</p>
        <h1>@Content.Hero.Name</h1>
        <p class="hero-tagline">@Content.Hero.Tagline</p>
        <p class="hero-summary">@Content.Hero.Summary</p>
        <div class="hero-highlights" aria-label="Profile highlights">
            @foreach (var highlight in Content.Hero.Highlights)
            {
                <span>@highlight</span>
            }
        </div>
        <div class="hero-actions">
            <a class="button primary" href="#projects">@Content.Hero.Ctas.Projects</a>
            <a class="button secondary" href="@SiteOptions.ResolvedCvUrl" download>@Content.Hero.Ctas.Cv</a>
            <a class="button ghost" href="#contact">@Content.Hero.Ctas.Contact</a>
        </div>
    </div>

    <div class="hero-panel" aria-label="Agrotech profile highlights">
        <div class="field-grid">
            @for (var index = 0; index < 12; index++)
            {
                <span></span>
            }
        </div>
        <div class="signal-card">
            <span class="signal-dot"></span>
            <strong>Field intelligence stack</strong>
            <small>C# / .NET · IoT · Python · Data · Automation</small>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public PortfolioContent Content { get; set; } = default!;
    [Parameter, EditorRequired] public SiteOptions SiteOptions { get; set; } = default!;
}
