@using JuanIgnacio.Portfolio.Web.Models
<section id="top" class="hero" aria-labelledby="hero-title">
    <div class="hero-photo" aria-hidden="true"></div>
    <div class="hero-survey" aria-hidden="true"><span class="survey-point p1"></span><span class="survey-point p2"></span><span class="survey-point p3"></span></div>
    <div class="section-shell hero-inner">
        <div class="hero-content">
            <p class="eyebrow"><span></span>@Content.Hero.Eyebrow</p>
            <h1 id="hero-title">Juan Ignacio<br /><span>Bastonero</span><span class="name-dot">.</span></h1>
            <p class="hero-tagline">@Content.Hero.Tagline</p>
            <p class="hero-summary">@Content.Hero.Summary</p>
            <div class="hero-actions">
                <a class="button primary" href="#projects">@Content.Hero.Ctas.Projects <Icon Name="arrow-up-right" /></a>
                <CvLink Content="Content" SiteOptions="SiteOptions" />
            </div>
            <div class="hero-social"><ProfessionalLink Label="GitHub" Url="@SiteOptions.GitHubUrl" Pending="@Content.Visual.Pending" /><ProfessionalLink Label="LinkedIn" Url="@SiteOptions.LinkedInUrl" Pending="@Content.Visual.Pending" /></div>
        </div>
        <div class="field-caption"><span class="crosshair" aria-hidden="true">+</span><div><span>@Content.Visual.FieldLabel</span><strong>@Content.Visual.FieldData</strong></div><span class="field-index">01 / AGRO 4.0</span></div>
    </div>
</section>
<div class="discipline-band"><div class="section-shell"><span>@Content.Hero.Highlights[0]</span><span aria-hidden="true">+</span><span>@Content.Hero.Highlights[1]</span><span aria-hidden="true">+</span><span>@Content.Hero.Highlights[2]</span><span class="discipline-end">AGRO 4.0 <Icon Name="sprout" /></span></div></div>
@code {
    [Parameter, EditorRequired] public PortfolioContent Content { get; set; } = default!;
    [Parameter, EditorRequired] public SiteOptions SiteOptions { get; set; } = default!;
}
