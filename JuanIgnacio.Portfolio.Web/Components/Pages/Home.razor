@page "/"
@rendermode InteractiveServer
@inject JuanIgnacio.Portfolio.Web.Services.PortfolioContentService ContentService
@inject Microsoft.Extensions.Options.IOptions<JuanIgnacio.Portfolio.Web.Models.SiteOptions> SiteOptionsAccessor
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@Content.Seo.Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Content.Seo.Description" />
    <meta name="keywords" content="@Content.Seo.Keywords" />
    <meta name="author" content="@Content.Seo.Author" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@CanonicalUrl" />

    <meta property="og:title" content="@Content.Seo.SocialTitle" />
    <meta property="og:description" content="@Content.Seo.SocialDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:image" content="@SocialImageUrl" />
    <meta property="og:image:alt" content="@Content.Seo.SocialTitle" />
    <meta property="og:locale" content="@OpenGraphLocale" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Content.Seo.SocialTitle" />
    <meta name="twitter:description" content="@Content.Seo.SocialDescription" />
    <meta name="twitter:image" content="@SocialImageUrl" />
    <meta name="twitter:image:alt" content="@Content.Seo.SocialTitle" />
</HeadContent>

<SiteHeader Content="Content"
            Languages="ContentService.Languages"
            CurrentLanguage="@currentLanguage"
            OnLanguageChanged="ChangeLanguage" />

<main id="main-content" lang="@currentLanguage">
<HeroSection Content="Content" SiteOptions="SiteOptions" />
<AboutSection Content="Content" />
<ProjectsSection Content="Content" SiteOptions="SiteOptions" />
<ExperienceSection Content="Content" />
<SkillsSection Content="Content" />
<ContactSection Content="Content" SiteOptions="SiteOptions" />
</main>

<footer class="site-footer">
    <div class="section-shell"><p>@Content.FooterText</p><a href="#top">@Content.Visual.Home <span aria-hidden="true">↑</span></a></div>
</footer>

@code {
    private string currentLanguage = "es";
    private JuanIgnacio.Portfolio.Web.Models.PortfolioContent Content => ContentService.Get(currentLanguage);
    private JuanIgnacio.Portfolio.Web.Models.SiteOptions SiteOptions => SiteOptionsAccessor.Value;
    private string CanonicalUrl => string.IsNullOrWhiteSpace(SiteOptions.PublicUrl) ? Navigation.BaseUri : SiteOptions.PublicUrl.TrimEnd('/') + "/";
    private string SocialImageUrl => ToAbsoluteUrl(SiteOptions.ResolvedSocialImageUrl);
    private string OpenGraphLocale => currentLanguage switch
    {
        "it" => "it_IT",
        "en" => "en_US",
        "fr" => "fr_FR",
        _ => "es_ES"
    };

    private async Task ChangeLanguage(string languageCode)
    {
        currentLanguage = ContentService.Languages.Any(l => l.Code == languageCode) ? languageCode : "es";
        await JS.InvokeVoidAsync("portfolioLanguage.set", currentLanguage, Content.Messages);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedLanguage = await JS.InvokeAsync<string?>("portfolioLanguage.get");
            await ChangeLanguage(savedLanguage ?? "es");
            StateHasChanged();
        }
    }

    private string ToAbsoluteUrl(string pathOrUrl)
    {
        if (Uri.TryCreate(pathOrUrl, UriKind.Absolute, out var absoluteUri))
        {
            return absoluteUri.ToString();
        }

        var baseUrl = CanonicalUrl;
        if (!Uri.TryCreate(baseUrl, UriKind.Absolute, out var baseUri))
        {
            baseUri = new Uri("http://localhost:5100/");
        }

        return new Uri(baseUri, pathOrUrl.TrimStart('/')).ToString();
    }
}
