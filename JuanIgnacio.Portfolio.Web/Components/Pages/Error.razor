@page "/Error"
@using System.Diagnostics
@rendermode InteractiveServer
@inject JuanIgnacio.Portfolio.Web.Services.PortfolioContentService ContentService
@inject IJSRuntime JS

<PageTitle>@Content.Messages.ErrorTitle</PageTitle>

<main class="section-shell content-section" lang="@Content.LanguageCode">
    <h1>@Content.Messages.ErrorTitle</h1>
    <p class="lead-text">@Content.Messages.Error</p>

@if (ShowRequestId)
{
    <p>
        <strong>@Content.Messages.RequestId:</strong> <code>@RequestId</code>
    </p>
}

    <a class="button secondary" href="/">@Content.Visual.Home</a>
</main>

@code{
    private string currentLanguage = "es";
    private JuanIgnacio.Portfolio.Web.Models.PortfolioContent Content => ContentService.Get(currentLanguage);
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var savedLanguage = await JS.InvokeAsync<string?>("portfolioLanguage.get");
        currentLanguage = ContentService.Get(savedLanguage ?? "es").LanguageCode;
        await JS.InvokeVoidAsync("portfolioLanguage.set", currentLanguage, Content.Messages);
        StateHasChanged();
    }
}
