# Production example for Juan Ignacio Portfolio.
# Copy this file to a real .env file outside git and replace the values.

PORTFOLIO_HTTP_PORT=8088
PORTFOLIO_EMAIL=contact@example.com
PORTFOLIO_LINKEDIN_URL=https://www.linkedin.com/in/your-public-profile
PORTFOLIO_GITHUB_URL=https://github.com/your-public-user
PORTFOLIO_CV_URL=cv/Juan-Ignacio-CV.pdf
PORTFOLIO_PUBLIC_URL=https://portfolio.example.com
PORTFOLIO_SOCIAL_IMAGE_URL=images/social-preview.png

# Contact form modes:
# mailto   -> uses PORTFOLIO_EMAIL
# api      -> posts to PORTFOLIO_CONTACT_API_URL
# formspree -> posts to PORTFOLIO_FORMSPREE_URL
PORTFOLIO_CONTACT_FORM_MODE=mailto
PORTFOLIO_CONTACT_API_URL=
PORTFOLIO_FORMSPREE_URL=
